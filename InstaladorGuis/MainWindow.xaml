<Window x:Class="InstaladorGuis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InstaladorGuis.Controls"
        xmlns:vm="clr-namespace:InstaladorGuis.ViewModels"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Instalador de GUIs"
        WindowState="Maximized"
        MinWidth="740"
        MinHeight="640"
        FontFamily="Segoe UI"
        Background="{StaticResource BrushCoconut100}"
        Icon="pack://application:,,,/Assets/icono-guis-installer.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="OnLoaded">

    <Window.Resources>
        <ItemsPanelTemplate x:Key="GuiGridPanel">
            <UniformGrid Columns="2" VerticalAlignment="Top"/>
        </ItemsPanelTemplate>
        <Style x:Key="GuiItemContainer" TargetType="ContentPresenter">
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <DataTemplate x:Key="GuiCardTemplate" DataType="{x:Type vm:GuiVm}">
            <Border Margin="4"
                    Height="48"
                    Padding="12,0"
                    CornerRadius="8"
                    BorderThickness="1"
                    Background="{Binding CardBackground}"
                    BorderBrush="{Binding AccentBrush}"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnGuiCardClick">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource GuiCheckBox}"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Label}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushBlackberry500}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,6,0"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusLabel}"
                               FontSize="11"
                               Foreground="{Binding StatusLabelBrush}"
                               Visibility="{Binding StatusLabelVisible}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Border Grid.Column="3"
                            Background="{Binding ChipBackground}"
                            CornerRadius="10"
                            Padding="7,3,8,3"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ic:FluentIcon Icon="{Binding TypeIcon}"
                                           IconVariant="Regular"
                                           FontSize="12"
                                           Foreground="{Binding ChipForeground}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding Chip}"
                                       Foreground="{Binding ChipForeground}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource BrushBlackberry500}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Rectangle Width="3" Fill="{StaticResource BrushCherry400}" HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="28,0,0,0">
                <TextBlock Text="INDITEX"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#B4FFFFFF"/>
                <TextBlock x:Name="BrandNameText"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,2,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="2"
                       Text="INSTALADOR DE GUIS"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#D2FFFFFF"
                       VerticalAlignment="Center"
                       Margin="0,0,28,0"/>
            <Rectangle Grid.ColumnSpan="3"
                       Height="3"
                       VerticalAlignment="Bottom"
                       Fill="{StaticResource BrushCherry400}"/>
        </Grid>

        <Grid x:Name="ContentHost" Grid.Row="1" SizeChanged="OnContentHostSizeChanged">
            <Grid x:Name="MainContent"
                  Width="1180"
                  Height="820"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="GUIs disponibles" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ToggleButton x:Name="FilterPaq"
                                          Content="Solo PAQ"
                                          Style="{StaticResource ChipToggle}"
                                          Margin="0,0,8,0"
                                          Checked="OnFilterChanged"
                                          Unchecked="OnFilterChanged"/>
                            <ToggleButton x:Name="FilterPrc"
                                          Content="Solo PRC"
                                          Style="{StaticResource ChipToggle}"
                                          Checked="OnFilterChanged"
                                          Unchecked="OnFilterChanged"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="Selecciona las GUIs que deseas instalar"
                               Foreground="{StaticResource BrushBlackberry300}"
                               FontSize="13"
                               Margin="0,10,0,12"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl x:Name="GuisPaqItems"
                                          VerticalAlignment="Top"
                                          ItemsPanel="{StaticResource GuiGridPanel}"
                                          ItemContainerStyle="{StaticResource GuiItemContainer}"
                                          ItemTemplate="{StaticResource GuiCardTemplate}"/>
                            <ItemsControl x:Name="GuisPrcItems"
                                          VerticalAlignment="Top"
                                          Margin="0,8,0,0"
                                          ItemsPanel="{StaticResource GuiGridPanel}"
                                          ItemContainerStyle="{StaticResource GuiItemContainer}"
                                          ItemTemplate="{StaticResource GuiCardTemplate}"/>
                            <TextBlock x:Name="FilterEmpty"
                                       Text="No hay GUIs de este tipo."
                                       Foreground="{StaticResource BrushBlackberry300}"
                                       Margin="4,16,4,4"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Background="{StaticResource BrushSand100}" CornerRadius="9" Padding="8,3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ic:FluentIcon Icon="Box"
                                               IconVariant="Regular"
                                               FontSize="12"
                                               Foreground="{StaticResource BrushSand500}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0"/>
                                <TextBlock Text="PAQ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushSand500}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Aplicaciones PAQ"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushBlackberry300}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,18,0"/>
                        <StackPanel x:Name="PrcLegend" Orientation="Horizontal">
                            <Border Background="{StaticResource BrushSage100}" CornerRadius="9" Padding="8,3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ic:FluentIcon Icon="ClothesHanger"
                                                   IconVariant="Regular"
                                                   FontSize="12"
                                                   Foreground="{StaticResource BrushSage500}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0"/>
                                    <TextBlock Text="PRC" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushSage500}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Aplicaciones PRC"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushBlackberry300}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Panel de control" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock x:Name="StatSelected"
                                           Text="0"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushOcean500}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="seleccionadas"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushBlackberry300}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource StatCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="StatInstalled"
                                               Text="0"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushKiwi500}"/>
                                    <TextBlock x:Name="StatInstalledSuffix"
                                               FontSize="13"
                                               Foreground="{StaticResource BrushBlackberry100}"
                                               VerticalAlignment="Bottom"
                                               Margin="6,0,0,6"/>
                                </StackPanel>
                                <TextBlock Text="instaladas"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushBlackberry300}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="VerificationBanner"
                            Grid.Row="2"
                            Visibility="Collapsed"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <TextBlock x:Name="VerificationText"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushBlackberry300}"/>
                    </Border>

                    <StackPanel Grid.Row="3">
                        <Button x:Name="InstallBtn"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnInstalar"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <ic:FluentIcon Icon="ArrowDownload"
                                               IconVariant="Regular"
                                               FontSize="16"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                <TextBlock x:Name="InstallLabel"
                                           Text="Instalar seleccionadas (0)"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="UninstallBtn"
                                Style="{StaticResource SecondaryButton}"
                                Click="OnDesinstalar"
                                IsEnabled="False"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <ic:FluentIcon Icon="Delete"
                                               IconVariant="Regular"
                                               FontSize="16"
                                               Foreground="{StaticResource BrushBlackberry500}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="Desinstalar seleccionadas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}"
                                Click="OnSeleccionarTodo"
                                Margin="0,0,0,8"
                                x:Name="SelectAllBtn">
                            <StackPanel Orientation="Horizontal">
                                <ic:FluentIcon Icon="SelectAllOn"
                                               IconVariant="Regular"
                                               FontSize="16"
                                               Foreground="{StaticResource BrushBlackberry500}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="Seleccionar todo" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}"
                                Click="OnDeseleccionarTodo"
                                Margin="0,0,0,8"
                                x:Name="DeselectAllBtn">
                            <StackPanel Orientation="Horizontal">
                                <ic:FluentIcon Icon="SelectAllOff"
                                               IconVariant="Regular"
                                               FontSize="16"
                                               Foreground="{StaticResource BrushBlackberry500}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="Deseleccionar todo" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}"
                                Click="OnRegistroLibre"
                                x:Name="RegistroLibreBtn">
                            <StackPanel Orientation="Horizontal">
                                <ic:FluentIcon Icon="Add"
                                               IconVariant="Regular"
                                               FontSize="16"
                                               Foreground="{StaticResource BrushBlackberry500}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="Registro libre de una GUI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border x:Name="SystemBanner"
                            Grid.Row="4"
                            Visibility="Collapsed"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SystemBannerTitle"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushBlackberry500}"/>
                            <TextBlock x:Name="SystemBannerText"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushBlackberry300}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource BrushCoconut300}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="FooterText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource BrushBlackberry100}"/>
        </Border>

        <controls:ChatbotControl x:Name="Chatbot"
                                 Grid.RowSpan="3"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,18,18"/>

        <controls:AppDialogHost x:Name="DialogHost" Grid.RowSpan="3"/>
    </Grid>
</Window>
