<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Blackberry100">#8C8C8C</Color>
    <Color x:Key="Blackberry200">#666666</Color>
    <Color x:Key="Blackberry300">#4D4D4D</Color>
    <Color x:Key="Blackberry500">#141414</Color>
    <Color x:Key="Coconut100">#F5F5F5</Color>
    <Color x:Key="Coconut200">#F0F0F0</Color>
    <Color x:Key="Coconut300">#E6E6E6</Color>
    <Color x:Key="Coconut400">#D6D6D6</Color>
    <Color x:Key="Coconut500">#BFBFBF</Color>
    <Color x:Key="Cherry400">#E12D3C</Color>
    <Color x:Key="Kiwi500">#2F9E44</Color>
    <Color x:Key="KiwiTint">#EEF7EF</Color>
    <Color x:Key="Apricot500">#E8862C</Color>
    <Color x:Key="Ocean500">#2563EB</Color>
    <Color x:Key="OceanTint">#EEF4FF</Color>
    <Color x:Key="OceanBorder">#C5D8F6</Color>
    <Color x:Key="Sand100">#EEE8E0</Color>
    <Color x:Key="Sand500">#6B5E4E</Color>
    <Color x:Key="Sage100">#E8EDF5</Color>
    <Color x:Key="Sage500">#455A7A</Color>

    <SolidColorBrush x:Key="BrushBlackberry100" Color="{StaticResource Blackberry100}"/>
    <SolidColorBrush x:Key="BrushBlackberry200" Color="{StaticResource Blackberry200}"/>
    <SolidColorBrush x:Key="BrushBlackberry300" Color="{StaticResource Blackberry300}"/>
    <SolidColorBrush x:Key="BrushBlackberry500" Color="{StaticResource Blackberry500}"/>
    <SolidColorBrush x:Key="BrushCoconut100" Color="{StaticResource Coconut100}"/>
    <SolidColorBrush x:Key="BrushCoconut200" Color="{StaticResource Coconut200}"/>
    <SolidColorBrush x:Key="BrushCoconut300" Color="{StaticResource Coconut300}"/>
    <SolidColorBrush x:Key="BrushCoconut400" Color="{StaticResource Coconut400}"/>
    <SolidColorBrush x:Key="BrushCoconut500" Color="{StaticResource Coconut500}"/>
    <SolidColorBrush x:Key="BrushWhite" Color="White"/>
    <SolidColorBrush x:Key="BrushCherry400" Color="{StaticResource Cherry400}"/>
    <SolidColorBrush x:Key="BrushKiwi500" Color="{StaticResource Kiwi500}"/>
    <SolidColorBrush x:Key="BrushKiwiTint" Color="{StaticResource KiwiTint}"/>
    <SolidColorBrush x:Key="BrushApricot500" Color="{StaticResource Apricot500}"/>
    <SolidColorBrush x:Key="BrushOcean500" Color="{StaticResource Ocean500}"/>
    <SolidColorBrush x:Key="BrushOceanTint" Color="{StaticResource OceanTint}"/>
    <SolidColorBrush x:Key="BrushOceanBorder" Color="{StaticResource OceanBorder}"/>
    <SolidColorBrush x:Key="BrushSand100" Color="{StaticResource Sand100}"/>
    <SolidColorBrush x:Key="BrushSand500" Color="{StaticResource Sand500}"/>
    <SolidColorBrush x:Key="BrushSage100" Color="{StaticResource Sage100}"/>
    <SolidColorBrush x:Key="BrushSage500" Color="{StaticResource Sage500}"/>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

    <Style x:Key="CardBorder" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushCoconut300}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource BrushBlackberry500}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#000000"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource BrushBlackberry500}"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BrushCoconut400}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushCoconut100}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBlackberry500}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushCoconut200}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="108"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,0,14,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd"
                            Background="White"
                            BorderBrush="{StaticResource BrushCoconut400}"
                            BorderThickness="1"
                            CornerRadius="15"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Mark"
                                    Width="14" Height="14"
                                    CornerRadius="3"
                                    BorderThickness="1.5"
                                    BorderBrush="{StaticResource BrushCoconut500}"
                                    Background="White"
                                    Margin="0,0,8,0">
                                <Path x:Name="Tick"
                                      Data="M2.5,7 L5.5,10 L11.5,3.5"
                                      Stroke="White"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushCoconut200}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBlackberry500}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBlackberry500}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBlackberry500}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="Mark" Property="Background" Value="{StaticResource BrushBlackberry500}"/>
                            <Setter TargetName="Mark" Property="BorderBrush" Value="White"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GuiCheckBox" TargetType="{x:Type CheckBox}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border x:Name="Box"
                            Width="18" Height="18"
                            CornerRadius="3"
                            BorderThickness="1.6"
                            BorderBrush="{StaticResource BrushCoconut500}"
                            Background="White">
                        <Path x:Name="Tick"
                              Data="M3,9 L7,13 L15,4"
                              Stroke="White"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Visibility="Collapsed"
                              Stretch="None"
                              Margin="1"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource BrushBlackberry500}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushBlackberry500}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushBlackberry500}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushCoconut400}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBlackberry500}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource BrushCoconut100}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

    <Style x:Key="SlimProgressBar" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Foreground" Value="{StaticResource BrushBlackberry500}"/>
        <Setter Property="Background" Value="{StaticResource BrushCoconut200}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <Decorator x:Name="PART_Track">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4"/>
                        </Decorator>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushBlackberry500}"/>
    </Style>
</ResourceDictionary>
