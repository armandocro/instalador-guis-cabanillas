<UserControl x:Class="InstaladorGuis.Controls.ChatbotControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:InstaladorGuis.Controls"
             xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="ChatWindow"
                Width="348"
                Height="470"
                Background="White"
                CornerRadius="12"
                BorderBrush="{StaticResource BrushCoconut300}"
                BorderThickness="1"
                Visibility="Collapsed"
                Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource BrushBlackberry500}"
                        CornerRadius="12,12,0,0">
                    <Grid>
                        <TextBlock Text="Asistente de soporte"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                        <Button HorizontalAlignment="Right"
                                Width="40"
                                Height="48"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OnCerrar"
                                ToolTip="Cerrar">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <TextBlock Text="✕"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer x:Name="MessagesScroll"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Background="{StaticResource BrushCoconut100}"
                              Padding="12">
                    <ItemsControl x:Name="MessagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ChatBubble}">
                                <Border Margin="0,0,0,8"
                                        Padding="12,10"
                                        CornerRadius="8"
                                        HorizontalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushCoconut300}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Margin" Value="0,0,4,8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushOceanTint}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushOceanBorder}"/>
                                                    <Setter Property="Margin" Value="28,0,0,8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Texto}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{StaticResource BrushBlackberry500}"/>
                                        <ItemsControl ItemsSource="{Binding Opciones}"
                                                      Margin="0,10,0,0"
                                                      Visibility="{Binding TieneOpciones, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:ChatOption}">
                                                    <Button Content="{Binding Texto}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Height="32"
                                                            FontSize="12"
                                                            FontWeight="Normal"
                                                            Margin="0,0,0,6"
                                                            Click="OnOptionClick"
                                                            Tag="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Button x:Name="ToggleBtn"
                Grid.Row="1"
                Width="56"
                Height="56"
                HorizontalAlignment="Right"
                Click="OnToggle"
                ToolTip="¿Te puedo ayudar?"
                Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{StaticResource BrushBlackberry500}"/>
                        <ic:FluentIcon Icon="Chat"
                                       IconVariant="Regular"
                                       FontSize="22"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="#1E1E1E"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
