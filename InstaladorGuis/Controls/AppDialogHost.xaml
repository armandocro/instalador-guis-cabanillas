<UserControl x:Class="InstaladorGuis.Controls.AppDialogHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             Panel.ZIndex="200">
    <Grid>
        <Border Background="#99000000"/>

        <Border x:Name="DialogCard"
                Width="480"
                MaxWidth="520"
                MinWidth="360"
                MaxHeight="520"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="White"
                CornerRadius="8"
                Margin="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40"
                                  ShadowDepth="8"
                                  Direction="270"
                                  Opacity="0.35"
                                  Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,24,24,8">
                    <StackPanel>
                        <TextBlock x:Name="TitleText"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushBlackberry500}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <!-- Mensaje / resumen -->
                        <TextBlock x:Name="MessageText"
                                   FontSize="14"
                                   LineHeight="22"
                                   Foreground="{StaticResource BrushBlackberry300}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>

                        <!-- Progreso -->
                        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                            <ProgressBar x:Name="Bar"
                                         Height="8"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Style="{StaticResource SlimProgressBar}"/>
                            <TextBlock x:Name="StatusText"
                                       Margin="0,14,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushBlackberry300}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="CountText"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushBlackberry100}"/>
                        </StackPanel>

                        <!-- Registro libre -->
                        <StackPanel x:Name="RegistroPanel" Visibility="Collapsed">
                            <TextBlock Text="Introduce la URL del JNLP para instalar manualmente una GUI en AMIGA."
                                       TextWrapping="Wrap"
                                       FontSize="14"
                                       LineHeight="22"
                                       Foreground="{StaticResource BrushBlackberry300}"/>
                            <TextBlock Text="URL de la GUI"
                                       FontWeight="SemiBold"
                                       Margin="0,16,0,6"/>
                            <TextBox x:Name="UrlBox" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <!-- Actualización (texto dinámico en MessageText) -->
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Background="#F3F3F3"
                        Padding="24,16"
                        CornerRadius="0,0,8,8">
                    <StackPanel x:Name="ButtonsPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="PrimaryBtn"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="120"
                                Click="OnPrimary"
                                Visibility="Collapsed"/>
                        <Button x:Name="SecondaryBtn"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="108"
                                Margin="8,0,0,0"
                                Click="OnSecondary"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
